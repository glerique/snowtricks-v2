{% extends 'base.html.twig' %}

{% block title %}Snowtricks{% endblock %}

{% block body %}
    <h1>Snowtricks</h1>
    <p class="lead mb-4">Découvrez et partagez les figures de snowboard.</p>

    {# Page numbers come from the paginator itself; there is no next page when 'next' is missing. #}
    {% set page = tricks.currentPageNumber %}
    {% set nextPage = tricks.paginationData.next ?? null %}

    {# Outside the frames on purpose: Turbo only copies the frame of a "Voir plus" response. #}
    {% if page > 1 %}
        <p><a href="{{ path('app_home') }}">&larr; Revenir au début</a></p>
    {% endif %}

    {% if tricks.items is empty %}
        <p class="text-body-secondary">Aucune figure pour le moment.</p>
    {% else %}
        {# "Voir plus" loads /?page=N and Turbo swaps the frame with the one of the same id in the response.
           Each page has its own .row: Bootstrap's grid only works on direct children of the row. #}
        <turbo-frame id="tricks-page-{{ page }}">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                {% for trick in tricks %}
                    <div class="col">
                        <div class="card h-100">
                            {% set cover = trick.coverImage %}
                            {% if cover %}
                                <div class="ratio ratio-4x3">
                                    <img src="{{ cover.source }}" class="card-img-top object-fit-cover" alt="{{ trick.name }}" loading="lazy">
                                </div>
                            {% else %}
                                <div class="ratio ratio-4x3 bg-body-secondary">
                                    <span class="d-flex align-items-center justify-content-center text-body-secondary">Pas d'image</span>
                                </div>
                            {% endif %}
                            <div class="card-body">
                                <h2 class="card-title h5">{{ trick.name }}</h2>
                                <p class="card-text text-body-secondary mb-0">{{ trick.category.name }} · par {{ trick.author.username }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% if nextPage %}
                <turbo-frame id="tricks-page-{{ nextPage }}">
                    <div class="text-center mb-4">
                        <a href="{{ path('app_home', {page: nextPage}) }}" class="btn btn-outline-primary">Voir plus</a>
                    </div>
                </turbo-frame>
            {% endif %}
        </turbo-frame>
    {% endif %}
{% endblock %}
