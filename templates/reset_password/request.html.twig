{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Snowtricks{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <h1 class="h3 mb-4">Mot de passe oublié</h1>

            <p>Saisissez l'adresse e-mail de votre compte. Nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>

            {{ form_start(form) }}
                {{ form_row(form.email) }}

                <button type="submit" class="btn btn-primary">Envoyer le lien</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
