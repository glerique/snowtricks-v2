{% extends 'base.html.twig' %}

{% block title %}{{ trick.name }} - Snowtricks{% endblock %}

{% block body %}
    <p><a href="{{ path('app_home') }}">&larr; Toutes les figures</a></p>

    <article>
        <header class="mb-4">
            <h1>{{ trick.name }}</h1>
            <p class="text-body-secondary mb-0">
                <span class="badge text-bg-primary">{{ trick.category.name }}</span>
                Par {{ trick.author.username }} · le {{ trick.createdAt|date('d/m/Y') }}
            </p>
        </header>

        {% if trick.images is not empty %}
            {# Bootstrap's grid only works on direct children of the row. #}
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mb-4">
                {% for image in trick.images %}
                    <div class="col">
                        <div class="ratio ratio-4x3">
                            <img src="{{ image.source }}" class="rounded object-fit-cover" alt="{{ trick.name }}" loading="lazy">
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <p>{{ trick.description|nl2br }}</p>

        {% if trick.videos is not empty %}
            <h2 class="h4 mt-4">Vidéos</h2>
            <ul>
                {% for video in trick.videos %}
                    <li><a href="{{ video.source }}" target="_blank" rel="noopener noreferrer">{{ video.source }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}
    </article>
{% endblock %}
